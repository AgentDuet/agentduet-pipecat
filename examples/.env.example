# Copy to examples/.env and fill in. Both example scripts call load_dotenv(),
# which resolves .env relative to this directory.
# .env is gitignored — never commit real credentials.

# Required by every example.
AGENTDUET_API_KEY=
AGENTDUET_CONNECTOR_UUID=

# Optional: override the AgentDuet base URL (defaults to production).
# AGENTDUET_BASE_URL=

# Required by examples/outbound_track_probe.py and examples/outbound_tone_bot.py.
# PROBE_SUBSCRIBER: the subscriber line the outbound call runs on behalf of.
# PROBE_DEST: E.164 number to dial — a phone you can answer.
PROBE_SUBSCRIBER=
PROBE_DEST=

# Required by examples/voice_bot.py only.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
# Optional: defaults to a real Cartesia voice id (British Reading Lady) in code.
CARTESIA_VOICE_ID=

# Optional, examples/call_and_wa_followup.py:
# WA_API_VERSION: WhatsApp Cloud API version used for the follow-up message; defaults to "v21.0".
# WA_FOLLOWUP_TO: WA address to send the post-call follow-up to when the caller dialed in over
#   TELCO (no WA thread to reply on) — lets the demo show the follow-up on a voice-only connector.
# WA_API_VERSION=
# WA_FOLLOWUP_TO=
