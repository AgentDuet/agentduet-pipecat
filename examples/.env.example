# Copy to examples/.env and fill in. Both example scripts call load_dotenv(),
# which resolves .env relative to this directory.
# .env is gitignored — never commit real credentials.

# Required by every example.
AGENTDUET_API_KEY=
AGENTDUET_CONNECTOR_UUID=

# Optional: override the AgentDuet base URL (defaults to production).
# AGENTDUET_BASE_URL=

# Required by examples/outbound_track_probe.py only.
# PROBE_SUBSCRIBER: the subscriber line the outbound call runs on behalf of.
# PROBE_DEST: E.164 number to dial — a phone you can answer.
PROBE_SUBSCRIBER=
PROBE_DEST=
